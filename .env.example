# Copy to .env; chmod 600 .env. Use URL-safe password (for example openssl rand -hex 32).
POSTGRES_PASSWORD=
OCR_DOMAIN=ocr.example.org
# External starter's server-only introspection endpoint, not a browser-supplied identity.
OCR_IDENTITY_URL=https://identity.example.org/internal/introspect
OCR_IDENTITY_SECRET=
# Backup scripts: export variables in a private environment file before running.
# Repository MUST be off-server. Initialize once with restic init.
RESTIC_REPOSITORY=sftp:backup@example.org:/srv/backups/ocr
RESTIC_PASSWORD_FILE=/etc/ocr/restic-password
